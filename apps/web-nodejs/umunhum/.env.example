# Vite Environment Variables (Frontend)
VITE_API_URL=

# Backend Server Configuration
HOST=0.0.0.0
PORT=3002
NODE_ENV=development

# Qdrant Configuration
QDRANT_HOST=x.x.x.x
QDRANT_PORT=6333
QDRANT_COLLECTION=prado_images

# Prado Service
PRADO_API_URL=http://x.x.x.x:3003
PRADO_ROOT=/home/your_root
# Note: Search queries are automatically rejected if a scan is in progress
# to prevent memory issues from running both operations simultaneously

# Embedding Mode: 'api' or 'local'
# - 'api': Use Prado API with GPU (fast, ~0.5s per image)
#          Automatically falls back to 'local' if Prado is unavailable
# - 'local': Use local CPU with SAM Python script (slower, ~5-10s per image, no GPU needed)
# Use 'local' mode to eliminate dependency on GPU box during queries
EMBED_MODE=local

# Upload Configuration
UPLOAD_DIR=/tmp/umunhum_uploads
MAX_FILE_SIZE=10485760
ALLOWED_TYPES=image/jpeg,image/png,image/jpg,image/bmp,image/webp

# Search Configuration
TOP_K=9
EMBEDDING_MODEL=clip