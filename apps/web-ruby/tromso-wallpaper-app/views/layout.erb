<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tromso Wallpaper - Ruby Edition</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: #000;
            overflow: hidden;
        }

        #wallpaper-container {
            width: 100vw;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-center;
            background: #000;
            position: relative;
        }

        #wallpaper-img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            opacity: 0;
            transition: opacity 0.5s ease-in-out;
        }

        #wallpaper-img.loaded {
            opacity: 1;
        }

        #controls {
            position: fixed;
            top: 20px;
            left: 20px;
            background: rgba(0, 0, 0, 0.7);
            color: #fff;
            padding: 20px;
            border-radius: 10px;
            z-index: 1000;
            display: none;
        }

        #controls.show {
            display: block;
        }

        #controls label {
            display: block;
            margin: 10px 0 5px;
            font-weight: bold;
        }

        #controls select,
        #controls input,
        #controls button {
            width: 100%;
            padding: 8px;
            margin-bottom: 10px;
            border-radius: 5px;
            border: 1px solid #444;
            background: #222;
            color: #fff;
        }

        #controls button {
            background: #0066cc;
            cursor: pointer;
            font-weight: bold;
        }

        #controls button:hover {
            background: #0052a3;
        }

        #theme-display {
            position: fixed;
            bottom: 20px;
            left: 20px;
            background: rgba(0, 0, 0, 0.7);
            color: #fff;
            padding: 10px 20px;
            border-radius: 5px;
            z-index: 999;
            opacity: 0;
            transition: opacity 0.3s;
        }

        #theme-display.show {
            opacity: 1;
        }

        #splash-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: #000;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-center;
            z-index: 2000;
            opacity: 1;
            transition: opacity 1s;
        }

        #splash-screen.fade-out {
            opacity: 0;
            pointer-events: none;
        }

        #splash-screen img {
            max-width: 300px;
            max-height: 300px;
        }

        #splash-screen h1 {
            color: #fff;
            margin-top: 20px;
        }

        .nav-hint {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: rgba(0, 0, 0, 0.7);
            color: #fff;
            padding: 10px 15px;
            border-radius: 5px;
            font-size: 12px;
            z-index: 999;
        }

        /* Loading indicator */
        .loading {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: #fff;
            font-size: 18px;
        }
    </style>
</head>
<body>
    <%= yield %>
</body>
</html>
