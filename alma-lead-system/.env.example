# ── Database ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=alma_db
POSTGRES_USER=alma_user
POSTGRES_PASSWORD=your-db-paasword
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── API ──
API_KEY=your-api-key-here
API_HOST=alma-api.thirdwavesoft.com
API_PORT=4002
CORS_ORIGINS=http://alma-lead.thirdwavsoft.com:4000,http://alma-internal.thirdwavsoft.com:4001

# ── Storage ──
STORAGE_BACKEND=local
UPLOAD_DIR=your-uploads-path

# S3 (when STORAGE_BACKEND=s3)
AWS_BUCKET_NAME=your-bucket-name
AWS_REGION=your-region
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# ── SMTP ──
SMTP_HOST=smtp.zebtoon.ai
SMTP_PORT=587
SMTP_USERNAME=zebtoon
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@zebtoon.ai
ATTORNEY_EMAIL=attorney@zebtoon.ai

# ── Next.js Lead Portal ──
NEXT_PUBLIC_API_URL=http://alma-api.thirdwavesoft.com:4002

# ── Next.js Internal Portal ──
NEXT_PUBLIC_API_URL=http://alma-api.thirdwavesoft.com:4002
INTERNAL_API_KEY=your-api-key-here
